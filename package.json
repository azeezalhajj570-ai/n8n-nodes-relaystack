{
  "name": "n8n-nodes-relaystack",
  "version": "0.2.1",
  "description": "n8n community node package for RelayStack API - messaging automation platform",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && cp package.json dist/ && find nodes -name '*.svg' -exec cp {} dist/{} \\;",
    "dev": "tsc --watch",
    "format": "prettier --write .",
    "lint": "eslint . --ext .ts",
    "test": "jest --passWithNoTests",
    "test:unit": "jest tests/unit --passWithNoTests",
    "test:integration": "jest tests/integration --passWithNoTests"
  },
  "n8n": {
    "credentials": [
      "dist/credentials/RelayStackApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/RelayStack/RelayStack.node.js",
      "dist/nodes/RelayStackTrigger/RelayStackTrigger.node.js"
    ]
  },
  "keywords": [
    "n8n",
    "n8n-community-node",
    "relaystack",
    "messaging"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azeezalhajj570-ai/n8n-nodes-relaystack.git"
  },
  "homepage": "https://github.com/azeezalhajj570-ai/n8n-nodes-relaystack#readme",
  "bugs": {
    "url": "https://github.com/azeezalhajj570-ai/n8n-nodes-relaystack/issues"
  },
  "dependencies": {
    "axios": "^1.7.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.0",
    "jest": "^29.7.0",
    "n8n-workflow": "^1.0.0",
    "prettier": "^3.2.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.4.0"
  }
}
